module(
    name = "actiond",
    version = "0.1.0",
)

bazel_dep(name = "rules_zig", version = "0.14.0")
bazel_dep(name = "apple_support", version = "2.5.4")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "llvm", version = "0.8.1")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")
single_version_override(
    module_name = "zstd",
    patch_strip = 1,
    patches = ["//third_party/patches:zstd_no_pthread.patch"],
    version = "1.5.7.bcr.1",
)

zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.toolchain(zig_version = "0.16.0")
use_repo(zig, "zig_toolchains")

register_toolchains("@zig_toolchains//:all")

register_toolchains("@llvm//toolchain:all")

osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "CoreFoundation",
    "CoreGraphics",
    "CoreServices",
    "CFNetwork",
    "DiskArbitration",
    "Foundation",
    "IOKit",
    "Kernel",
    "OSLog",
    "Security",
    "SystemConfiguration",
    "Virtualization",
])
use_repo(osx, "macos_sdk")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "linux_kernel_src",
    build_file_content = """
exports_files(["Makefile"])

filegroup(
    name = "all",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "cc12a7644b4cef9e06627b29de8753e22b3d076703a9b52be84263e05c8b9830",
    strip_prefix = "linux-6.12.87",
    urls = ["https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.87.tar.xz"],
)

glibc_deb_runtime = use_repo_rule("//runtimes:glibc_runtime_repo.bzl", "glibc_deb_runtime")

glibc_deb_runtime(
    name = "glibc_2_31_aarch64",
    arch = "aarch64",
