load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_zig//zig:defs.bzl", "zig_binary")

MACOS_SDK = "@macos_sdk//sysroot:sysroot"
MACOS_SDK_LINKOPTS = [
    "-F$(execpath %s)/System/Library/Frameworks" % MACOS_SDK,
    "-L$(execpath %s)/usr/lib" % MACOS_SDK,
]

objc_library(
    name = "vz_bridge",
    srcs = ["vz_bridge.m"],
    copts = [
        "-fblocks",
        "-fobjc-arc",
    ],
    sdk_frameworks = [
        "Foundation",
        "Virtualization",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

zig_binary(
    name = "darwin-actiond-bin",
    data = [MACOS_SDK],
    extra_srcs = [MACOS_SDK],
    linkopts = MACOS_SDK_LINKOPTS,
    main = "main.zig",
    strip_debug_symbols = True,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":vz_bridge",
        "//src:actiond",
        "@zstd",
    ],
)

genrule(
    name = "darwin-actiond-signed",
    srcs = [
        ":darwin-actiond-bin",
        "darwin-actiond.entitlements",
    ],
    outs = ["darwin-actiond"],
    cmd = """
set -euo pipefail
cp "$(location :darwin-actiond-bin)" "$@"
chmod +x "$@"
/usr/bin/codesign --force --sign - --entitlements "$(location darwin-actiond.entitlements)" "$@"
""",
    executable = True,
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

zig_binary(
    name = "darwin-actiond-standalone-bin",
    data = [
        ":darwin-standalone-payload",
        MACOS_SDK,
    ],
    extra_srcs = [
        ":darwin-standalone-payload",
        MACOS_SDK,
    ],
    linkopts = [
        "$(location :darwin-standalone-payload)",
    ] + MACOS_SDK_LINKOPTS,
    main = "main.zig",
    strip_debug_symbols = True,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":vz_bridge",
        "//src:actiond",
        "@zstd",
    ],
)

genrule(
    name = "darwin-standalone-payload",
    srcs = [
        "//runtimes:runtimes_squashfs_aarch64",
        "//vm:initramfs",
        "//vm:linux_kernel",
    ],
    outs = ["darwin-standalone-payload.o"],
    cmd = """
set -euo pipefail
anchor_c="$(@D)/darwin-standalone-payload-anchor.c"
anchor_o="$(@D)/darwin-standalone-payload-anchor.o"
printf '%s\n' 'void actiond_standalone_payload_anchor(void) {}' > "$${anchor_c}"
/usr/bin/clang -c -arch arm64 "$${anchor_c}" -o "$${anchor_o}"
/usr/bin/ld -r -arch arm64 "$${anchor_o}" \
  -sectcreate __ACTIOND __kernel "$(location //vm:linux_kernel)" \
  -sectcreate __ACTIOND __initramfs "$(location //vm:initramfs)" \
  -sectcreate __ACTIOND __runtimes "$(location //runtimes:runtimes_squashfs_aarch64)" \
  -o "$@"
""",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

genrule(
    name = "darwin-actiond-standalone_pkg",
    srcs = [
        ":darwin-actiond-standalone-bin",
        "darwin-actiond.entitlements",
    ],
    outs = ["darwin-actiond-standalone"],
    cmd = """
set -euo pipefail
cp "$(location :darwin-actiond-standalone-bin)" "$@"
chmod +x "$@"
/usr/bin/codesign --force --sign - --entitlements "$(location darwin-actiond.entitlements)" "$@"
""",
    executable = True,
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)
