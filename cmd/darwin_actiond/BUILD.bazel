load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_zig//zig:defs.bzl", "zig_binary")

objc_library(
    name = "vz_bridge",
    srcs = ["vz_bridge.m"],
    copts = [
        "-fblocks",
        "-fobjc-arc",
    ],
    sdk_frameworks = [
        "Foundation",
        "Virtualization",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

zig_binary(
    name = "darwin-actiond-bin",
    main = "main.zig",
    strip_debug_symbols = True,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":vz_bridge",
        "//src:actiond",
        "@zstd",
    ],
)

genrule(
    name = "darwin-actiond-signed",
    srcs = [
        ":darwin-actiond-bin",
        "darwin-actiond.entitlements",
    ],
    outs = ["darwin-actiond"],
    cmd = """
set -euo pipefail
cp "$(location :darwin-actiond-bin)" "$@"
chmod +x "$@"
/usr/bin/codesign --force --sign - --entitlements "$(location darwin-actiond.entitlements)" "$@"
""",
    exec_compatible_with = ["@platforms//os:macos"],
    executable = True,
    tags = ["local"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

zig_binary(
    name = "darwin-actiond-standalone-bin",
    main = "main.zig",
    strip_debug_symbols = True,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":darwin-standalone-payload-lib",
        ":vz_bridge",
        "//src:actiond",
        "@zstd",
    ],
)

genrule(
    name = "darwin-standalone-payload",
    srcs = [
        "//runtimes:runtimes_squashfs_aarch64",
        "//vm:initramfs",
        "//vm:linux_kernel_zst",
    ],
    outs = ["darwin-standalone-payload.o"],
    cmd = """
set -euo pipefail
anchor_c="$(@D)/darwin-standalone-payload-anchor.c"
anchor_o="$(@D)/darwin-standalone-payload-anchor.o"
printf '%s\n' 'void actiond_standalone_payload_anchor(void) {}' > "$${anchor_c}"
"$(execpath @llvm//tools:clang)" -c -target arm64-apple-macos14.0 "$${anchor_c}" -o "$${anchor_o}"
"$(execpath @llvm//tools:llvm-objcopy)" \
  --add-section __ACTIOND,__kernel="$(location //vm:linux_kernel_zst)" \
  --add-section __ACTIOND,__initramfs="$(location //vm:initramfs)" \
  --add-section __ACTIOND,__runtimes="$(location //runtimes:runtimes_squashfs_aarch64)" \
  "$${anchor_o}" "$@"
""",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    tools = [
        "@llvm//tools:clang",
        "@llvm//tools:llvm-objcopy",
    ],
)

cc_library(
    name = "darwin-standalone-payload-lib",
    srcs = [":darwin-standalone-payload"],
    target_compatible_with = ["@platforms//os:macos"],
    alwayslink = True,
)

genrule(
    name = "darwin-actiond-standalone_pkg",
    srcs = [
        ":darwin-actiond-standalone-bin",
        "darwin-actiond.entitlements",
    ],
    outs = ["darwin-actiond-standalone"],
    cmd = """
set -euo pipefail
cp "$(location :darwin-actiond-standalone-bin)" "$@"
chmod +x "$@"
/usr/bin/codesign --force --sign - --entitlements "$(location darwin-actiond.entitlements)" "$@"
""",
    exec_compatible_with = ["@platforms//os:macos"],
    executable = True,
    tags = [
        "local",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)
