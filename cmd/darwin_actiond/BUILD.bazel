load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_zig//zig:defs.bzl", "zig_binary")

objc_library(
    name = "vz_bridge",
    srcs = ["vz_bridge.m"],
    copts = [
        "-fblocks",
        "-fobjc-arc",
    ],
    sdk_frameworks = [
        "Foundation",
        "Virtualization",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

zig_binary(
    name = "darwin-actiond-bin",
    main = "main.zig",
    strip_debug_symbols = True,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":vz_bridge",
        "//src:actiond",
        "@zstd",
    ],
)

genrule(
    name = "darwin-actiond-signed",
    srcs = [
        ":darwin-actiond-bin",
        "darwin-actiond.entitlements",
    ],
    outs = ["darwin-actiond"],
    cmd = """
set -euo pipefail
cp "$(location :darwin-actiond-bin)" "$@"
chmod +x "$@"
/usr/bin/codesign --force --sign - --entitlements "$(location darwin-actiond.entitlements)" "$@"
""",
    exec_compatible_with = ["@platforms//os:macos"],
    executable = True,
    tags = ["local"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

zig_binary(
    name = "darwin-actiond-standalone-bin",
    main = "main.zig",
    strip_debug_symbols = True,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":darwin-standalone-payload-sections",
        ":vz_bridge",
        "//src:actiond",
        "@zstd",
    ],
)

cc_library(
    name = "darwin-standalone-payload-sections",
    additional_linker_inputs = [
        "//runtimes:runtimes_squashfs_aarch64",
        "//vm:initramfs",
        "//vm:linux_kernel_zst",
    ],
    linkopts = [
        "-Wl,-sectcreate,__ACTIOND,__kernel,$(location //vm:linux_kernel_zst)",
        "-Wl,-sectcreate,__ACTIOND,__initramfs,$(location //vm:initramfs)",
        "-Wl,-sectcreate,__ACTIOND,__runtimes,$(location //runtimes:runtimes_squashfs_aarch64)",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

genrule(
    name = "darwin-actiond-standalone_pkg",
    srcs = [
        ":darwin-actiond-standalone-bin",
        "darwin-actiond.entitlements",
    ],
    outs = ["darwin-actiond-standalone"],
    cmd = """
set -euo pipefail
cp "$(location :darwin-actiond-standalone-bin)" "$@"
chmod +x "$@"
/usr/bin/codesign --force --sign - --entitlements "$(location darwin-actiond.entitlements)" "$@"
""",
    exec_compatible_with = ["@platforms//os:macos"],
    executable = True,
    tags = [
        "local",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)
