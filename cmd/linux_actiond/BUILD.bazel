$(execpath //tools:embed_payload) "$@" "$(location :linux-actiond-linux-x86_64)" runtimes.sqfs="$(location //runtimes:runtimes_squashfs_x86_64)"
chmod +x "$@"
""",
    executable = True,
    tools = ["//tools:embed_payload"],
    visibility = ["//visibility:public"],
)
