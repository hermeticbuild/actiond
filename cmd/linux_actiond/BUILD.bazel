""",
    executable = True,
    tools = ["//tools:embed_payload"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "linux-actiond-standalone-x86_64_pkg",
    srcs = [
        ":linux-actiond-linux-x86_64",
        "//runtimes:runtimes_squashfs_x86_64",
    ],
    outs = ["linux-actiond-standalone-x86_64"],
    cmd = """
