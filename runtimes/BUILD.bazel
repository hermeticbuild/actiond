genrule(
    name = "runtimes_squashfs",
    srcs = [
        "@glibc_2_31_aarch64//:runtime_manifest.json",
        "@glibc_2_31_aarch64//:tree",
        "@glibc_2_31_x86_64//:runtime_manifest.json",
        "@glibc_2_31_x86_64//:tree",
        "@glibc_2_35_aarch64//:runtime_manifest.json",
        "@glibc_2_35_aarch64//:tree",
        "@glibc_2_35_x86_64//:runtime_manifest.json",
        "@glibc_2_35_x86_64//:tree",
        "@glibc_2_39_aarch64//:runtime_manifest.json",
        "@glibc_2_39_aarch64//:tree",
        "@glibc_2_39_x86_64//:runtime_manifest.json",
        "@glibc_2_39_x86_64//:tree",
    ],
    outs = ["runtimes.sqfs"],
    cmd = """
set -euo pipefail
tree="$(@D)/runtimes-tree"
rm -rf "$${tree}"
mkdir -p "$${tree}/libc"

copy_runtime() {
  local repo_root="$$1"
  local libc="$$2"
  local arch="$$3"
  local dest="$${tree}/libc/$${libc}/$${arch}"
  mkdir -p "$${dest}"
  cp -RL "$${repo_root}/root" "$${dest}/root"
  cp "$${repo_root}/runtime_manifest.json" "$${dest}/runtime_manifest.json"
}

copy_runtime "$$(dirname "$(location @glibc_2_31_aarch64//:runtime_manifest.json)")" glibc2.31 aarch64
copy_runtime "$$(dirname "$(location @glibc_2_31_x86_64//:runtime_manifest.json)")" glibc2.31 x86_64
copy_runtime "$$(dirname "$(location @glibc_2_35_aarch64//:runtime_manifest.json)")" glibc2.35 aarch64
copy_runtime "$$(dirname "$(location @glibc_2_35_x86_64//:runtime_manifest.json)")" glibc2.35 x86_64
copy_runtime "$$(dirname "$(location @glibc_2_39_aarch64//:runtime_manifest.json)")" glibc2.39 aarch64
copy_runtime "$$(dirname "$(location @glibc_2_39_x86_64//:runtime_manifest.json)")" glibc2.39 x86_64

"$(execpath //tools:sqfs_pack)" "$${tree}" "$@"
""",
    tools = ["//tools:sqfs_pack"],
    visibility = ["//visibility:public"],
)
