expand_template(
    name = "dirpaths_h",
    out = "generated/lib/dirpaths.h",
    substitutions = {
        "@datadir@": "/usr/share",
        "@root_sysconfdir@": "/etc",
    },
    template = "lib/dirpaths.h.in",
)

copy_file(
    name = "blkid_h",
    src = "lib/blkid/blkid.h.in",
    out = "generated/lib/blkid/blkid.h",
    allow_symlink = True,
)

copy_file(
    name = "uuid_h",
    src = "lib/uuid/uuid.h.in",
    out = "generated/lib/uuid/uuid.h",
    allow_symlink = True,
)

expand_template(
    name = "ext2_types_h",
    out = "generated/lib/ext2fs/ext2_types.h",
    substitutions = {
        "@ASM_TYPES_HEADER@": "",
        "@PUBLIC_CONFIG_HEADER@": """/* These defines are needed for the public ext2fs.h header file */
#define HAVE_SYS_TYPES_H 1
#define SIZEOF_TIME_T 8
#undef WORDS_BIGENDIAN""",
        "@SIZEOF_INT@": "4",
        "@SIZEOF_LONG@": "8",
        "@SIZEOF_LONG_LONG@": "8",
        "@SIZEOF_SHORT@": "2",
    },
    template = "lib/ext2fs/ext2_types.h.in",
)

expand_template(
    name = "blkid_types_h",
    out = "generated/lib/blkid/blkid_types.h",
    substitutions = TYPE_HEADER_SUBSTITUTIONS,
    template = "lib/blkid/blkid_types.h.in",
)

expand_template(
    name = "uuid_types_h",
    out = "generated/lib/uuid/uuid_types.h",
    substitutions = TYPE_HEADER_SUBSTITUTIONS,
    template = "lib/uuid/uuid_types.h.in",
)

cc_binary(
    name = "gen_crc32ctable",
    srcs = [
        "lib/ext2fs/crc32c_defs.h",
        "lib/ext2fs/gen_crc32ctable.c",
    ],
    includes = ["lib/ext2fs"],
)

genrule(
    name = "crc32c_table_h",
    outs = ["generated/lib/ext2fs/crc32c_table.h"],
    cmd = "$(execpath :gen_crc32ctable) > $@",
    tools = [":gen_crc32ctable"],
)

expand_template(
    name = "ext2_err_et",
    out = "generated/lib/ext2fs/ext2_err.et",
    substitutions = {
        "@E2FSPROGS_VERSION@": "1.47.4",
    },
    template = "lib/ext2fs/ext2_err.et.in",
)

genrule(
    name = "ext2_err_h",
    srcs = [
        ":ext2_err_et",
        "lib/et/et_h.awk",
    ],
    outs = ["generated/lib/ext2fs/ext2_err.h"],
    cmd = "awk -f $(location lib/et/et_h.awk) 'outfile=$@' 'outfn=ext2_err.h' $(location :ext2_err_et)",
)

genrule(
    name = "ext2_err_c",
    srcs = [
        ":ext2_err_et",
        "lib/et/et_c.awk",
    ],
    outs = ["generated/lib/ext2fs/ext2_err.c"],
    cmd = "awk -f $(location lib/et/et_c.awk) 'outfile=$@' 'outfn=ext2_err.c' $(location :ext2_err_et)",
)

genrule(
    name = "prof_err_h",
    srcs = [
        "lib/et/et_h.awk",
        "lib/support/prof_err.et",
    ],
    outs = ["generated/lib/support/prof_err.h"],
    cmd = "awk -f $(location lib/et/et_h.awk) 'outfile=$@' 'outfn=prof_err.h' $(location lib/support/prof_err.et)",
)

genrule(
    name = "prof_err_c",
    srcs = [
        "lib/et/et_c.awk",
        "lib/support/prof_err.et",
    ],
    outs = ["generated/lib/support/prof_err.c"],
    cmd = "awk -f $(location lib/et/et_c.awk) 'outfile=$@' 'outfn=prof_err.c' $(location lib/support/prof_err.et)",
)

genrule(
    name = "default_profile_c",
    srcs = [
        "misc/mke2fs.conf.in",
        "misc/profile-to-c.awk",
    ],
    outs = ["generated/misc/default_profile.c"],
    cmd = "awk -f $(location misc/profile-to-c.awk) < $(location misc/mke2fs.conf.in) > $@",
)

cc_library(
    name = "headers",
    hdrs = glob([
        "lib/**/*.h",
        "misc/*.h",
        "version.h",
    ]) + [
        ":config_h",
        ":crc32c_table_h",
        ":dirpaths_h",
        ":ext2_err_h",
        ":blkid_h",
        ":blkid_types_h",
        ":prof_err_h",
        ":ext2_types_h",
        ":uuid_h",
        ":uuid_types_h",
    ],
    includes = [
        ".",
        "generated/lib",
        "generated/lib/blkid",
        "generated/lib/ext2fs",
        "generated/lib/support",
        "generated/lib/uuid",
        "lib",
    ],
)

