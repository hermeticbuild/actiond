diff --git a/internal/cmd/capture/capture.c b/internal/cmd/capture/capture.c
new file mode 100644
--- /dev/null
+++ b/internal/cmd/capture/capture.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright The Monogon Project Authors.
+
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#ifdef _WIN32
+#include <process.h>
+#define execvp _execvp
+#define chmod _chmod
+#else
+#include <unistd.h>
+#endif
+
+static int copy_file(const char *source, const char *destination) {
+    FILE *in = fopen(source, "rb");
+    if (!in) { perror(source); return 0; }
+    FILE *out = fopen(destination, "wb");
+    if (!out) { perror(destination); fclose(in); return 0; }
+    char buffer[65536];
+    size_t size;
+    int failed = 0;
+    while ((size = fread(buffer, 1, sizeof(buffer), in))) {
+        if (fwrite(buffer, 1, size, out) != size) { failed = 1; break; }
+    }
+    if (ferror(in)) failed = 1;
+    if (fclose(in)) failed = 1;
+    if (fclose(out)) failed = 1;
+    if (failed || chmod(destination, 0644)) { perror(destination); return 0; }
+    return 1;
+}
+
+int main(int argc, char **argv) {
+    if (argc >= 5 && !strcmp(argv[1], "--copy")) {
+        if (!copy_file(argv[2], argv[3])) return 1;
+        execvp(argv[4], argv + 4);
+        perror(argv[4]);
+        return 127;
+    }
+    if (argc < 4) {
+        fprintf(stderr, "usage: capture INPUT|- OUTPUT COMMAND [ARGS...]\n");
+        return 2;
+    }
+    if (strcmp(argv[1], "-") && !freopen(argv[1], "rb", stdin)) {
+        perror(argv[1]);
+        return 1;
+    }
+    if (!freopen(argv[2], "wb", stdout)) {
+        perror(argv[2]);
+        return 1;
+    }
+    execvp(argv[3], argv + 3);
+    perror(argv[3]);
+    return 127;
+}
