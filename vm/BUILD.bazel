load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@linux.bzl//:linux.bzl", "initramfs", "linux")

initramfs(
    name = "initramfs",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
        "/dev/zero": "1:5",
    },
    directories = [
        "/cas",
        "/proc",
        "/runtimes",
        "/sys/fs/cgroup",
        "/tmp",
        "/work",
    ],
    executables = {
        "/actiond": "//cmd/linux_actiond_guest:linux-actiond-guest",
        "/init": "//cmd/linux_actiond_guest:linux-actiond-guest",
        "/sbin/mkfs.ext4": "@e2fsprogs//:mkfs_ext4.stripped",
    },
    tags = ["manual"],
)

platform_transition_filegroup(
    name = "initramfs_aarch64",
    srcs = [":initramfs"],
    target_platform = "//platforms:linux_aarch64_musl",
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "initramfs_x86_64",
    srcs = [":initramfs"],
    tags = ["manual"],
    target_platform = "//platforms:linux_x86_64_musl",
    visibility = ["//visibility:public"],
)

linux(
    name = "linux_kernel",
    compact_repos = {
        "aarch64": "@actiond_vm_aarch64_compact",
        "x86_64": "@actiond_vm_x86_64_compact",
    },
    config = {
        "aarch64": "@actiond_vm_aarch64_kconfig//:kconfig",
        "x86_64": "@actiond_vm_x86_64_kconfig//:kconfig",
    },
    config_mode = "allnoconfig",
    extra_kconfigs = {
        "//kernel/actiondfs:Kconfig": "fs/actiondfs",
    },
    extra_srcs = ["//kernel/actiondfs:srcs"],
    source_repo = "@linux_6_18_2",
    visibility = ["//visibility:public"],
)

run_binary(
    name = "linux_kernel.image_zst",
    srcs = [":linux_kernel.image"],
    outs = ["Image.zst"],
    args = [
        "-q",
        "--ultra",
        "-22",
        "-f",
        "$(location :linux_kernel.image)",
        "-o",
        "$(location :Image.zst)",
    ],
    tool = "@zstd//:zstd_cli",
    visibility = ["//visibility:public"],
)
