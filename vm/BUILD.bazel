genrule(
    name = "initramfs",
    srcs = ["//cmd/linux_actiond_guest:linux-actiond-guest-aarch64"],
    outs = ["initramfs.cpio.zst"],
    cmd = "$(execpath //tools:initramfs_newc) $@ $(location //cmd/linux_actiond_guest:linux-actiond-guest-aarch64)",
    tools = ["//tools:initramfs_newc"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "linux_kernel",
    srcs = [
        "linux.config",
        "//tools:build_linux_kernel.sh",
        "//tools/docker:kernel.Dockerfile",
        "@linux_kernel_src//:Makefile",
        "@linux_kernel_src//:all",
    ],
    outs = ["Image"],
    cmd = "$(location //tools:build_linux_kernel.sh) $@ $(location linux.config) $(execpath @linux_kernel_src//:Makefile) $(location //tools/docker:kernel.Dockerfile)",
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "linux_kernel_zst",
    srcs = [":linux_kernel"],
    outs = ["Image.zst"],
    cmd = "$(execpath //tools:zstd_file) $(location :linux_kernel) $@",
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    tools = ["//tools:zstd_file"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "vm_bundle",
    srcs = [
        ":initramfs",
        ":linux_kernel_zst",
        "//runtimes:runtimes_squashfs",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
