genrule(
    name = "initramfs",
    srcs = ["//cmd/linux_actiond:linux-actiond-guest-aarch64"],
    outs = ["initramfs.cpio"],
    cmd = "$(execpath //tools:initramfs_newc) $@ $(location //cmd/linux_actiond:linux-actiond-guest-aarch64)",
    tools = ["//tools:initramfs_newc"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "linux_kernel",
    srcs = [
        "linux.config",
        "@linux_kernel_src//:Makefile",
        "@linux_kernel_src//:all",
    ],
    outs = ["Image"],
    cmd = """
set -euo pipefail
KERNEL_SRC="$$(dirname "$(execpath @linux_kernel_src//:Makefile)")"
KBUILD_OUT="$$(pwd)/$(@D)/kbuild"
MAKE_BIN="$$(command -v gmake || command -v make)"
CROSS_COMPILE_ARG=""
if command -v aarch64-linux-gnu-gcc >/dev/null 2>&1; then
  CROSS_COMPILE_ARG="CROSS_COMPILE=aarch64-linux-gnu-"
fi
mkdir -p "$${KBUILD_OUT}"
cp "$(location linux.config)" "$${KBUILD_OUT}/.config"
"$${MAKE_BIN}" -C "$${KERNEL_SRC}" O="$${KBUILD_OUT}" ARCH=arm64 $${CROSS_COMPILE_ARG} olddefconfig Image
cp "$${KBUILD_OUT}/arch/arm64/boot/Image" "$@"
""",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "vm_bundle",
    srcs = [
        ":initramfs",
        ":linux_kernel",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
